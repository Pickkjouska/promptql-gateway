# 反向代理 + TLS 终止示例
# 放到 /etc/nginx/sites-enabled/promptql-gateway.conf
# 证书可用 certbot 申请: certbot --nginx -d gw.example.com

server {
    listen 80;
    server_name gw.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name gw.example.com;

    ssl_certificate     /etc/letsencrypt/live/gw.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gw.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 20m;      # 凭据 txt 批量导入

    # SSE 流式：必须关缓冲，否则 token 会被攒着一起吐
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 600s;       # 上游 agent 思考可能很久
    proxy_send_timeout 600s;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location / {
        proxy_pass http://127.0.0.1:8080;
    }

    # 管理前端建议加一层 Basic Auth（可选）
    # location / { auth_basic "restricted"; auth_basic_user_file /etc/nginx/.htpasswd; proxy_pass http://127.0.0.1:8080; }
}
